# Sourced configuration — every value has a safe default, so this file is
# entirely optional. Copy to `.env` and adjust as needed.

# --- HTTP server ---
SOURCED_HOST=0.0.0.0
SOURCED_PORT=7700
# Comma-separated origins, or leave blank to allow all.
SOURCED_CORS_ORIGIN=

# --- Storage ---
# Directory for the persisted index (created automatically).
SOURCED_DATA_DIR=data
# Full path to the index file (defaults to <SOURCED_DATA_DIR>/index.json).
# SOURCED_INDEX_FILE=data/index.json
# Directory containing the built web UI.
SOURCED_WEB_DIR=web/dist
# Delay before flushing index changes to disk (ms).
SOURCED_PERSIST_DEBOUNCE_MS=750

# --- Logging ---
# trace | debug | info | warn | error | silent
SOURCED_LOG_LEVEL=info
SOURCED_LOG_PRETTY=false

# --- Crawler ---
SOURCED_CRAWL_USER_AGENT=SourcedBot/1.0
SOURCED_CRAWL_MAX_PAGES=50
SOURCED_CRAWL_CONCURRENCY=4
SOURCED_CRAWL_TIMEOUT_MS=15000
SOURCED_CRAWL_DELAY_MS=150
# Allow the HTTP /api/crawl endpoint to reach loopback / private / link-local
# hosts. Off by default as an SSRF guard. The `sourced crawl` CLI always allows it.
SOURCED_CRAWL_ALLOW_PRIVATE=false

# --- Limits ---
SOURCED_MAX_BODY_BYTES=8388608

# --- Discovery cascade (the "never a dead end" search) ------------------------
# When the web UI (or `?fallback=1`) searches, a query that the local index
# can't satisfy fans out to public, no-key sources — Wikipedia, the Wayback
# Machine, Common Crawl, Hacker News, certificate transparency — plus any
# configured web-search provider (see "Answer synthesis" below; the same
# SOURCED_ANSWER_WEB_SEARCH / SEARXNG_URL / *_API_KEY settings are reused).
# A valid non-empty query always returns at least related material or search
# shortcuts — never a blank "no results" page.
SOURCED_DISCOVERY_ENABLED=true
# Overall deadline for a normal / deep search (ms). Providers also self-timeout.
SOURCED_DISCOVERY_BUDGET_MS=5000
SOURCED_DISCOVERY_DEEP_BUDGET_MS=15000
# Fetch + index the top few newly-discovered public pages (robots + SSRF-guarded)
# so repeat searches increasingly resolve straight from the local index.
SOURCED_DISCOVERY_CRAWL=true

# --- Number plate checker ---------------------------------------------------
# All optional. Without them, plate checks still run format / age / region
# analysis fully offline. Each var below is also accepted with a SOURCED_
# prefix (e.g. SOURCED_DVLA_VES_API_KEY) if you prefer one namespace.
#
# DVLA Vehicle Enquiry Service (free): make, colour, year, tax & MOT status.
# Register: https://register-for-vehicle-enquiry-service.service.gov.uk/
DVLA_VES_API_KEY=
# Override for the DVLA sandbox environment, if you have one.
# DVLA_VES_BASE_URL=https://uat.driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
#
# DVSA MOT History API (free): full MOT test history, mileage, defects.
# Register: https://documentation.history.mot.api.gov.uk/
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
# MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
# MOT_BASE_URL=https://history.mot.api.gov.uk/v1/trade/vehicles/registration
#
# Per-request timeout for the DVLA / DVSA HTTP calls (ms).
SOURCED_PLATE_TIMEOUT_MS=12000
# Store every plate check in the search index as a document.
SOURCED_PLATE_INDEX_RESULTS=false

# --- Answer synthesis ----------------------------------------------------
# For question-like queries the Search tab also returns a short written answer
# woven from retrieved sources, with per-sentence citations, trust tiers and a
# confidence banner. Everything here is OPTIONAL. With nothing configured the
# answer is a deterministic weave of local-index extracts only.
#
# Master switch and the question-like auto-answer behaviour:
SOURCED_ANSWER_ENABLED=true
SOURCED_ANSWER_AUTO=true
#
# Live web sources. Pick one provider and set its credential; without one, the
# answer is built from the local index alone.
#   brave  — https://brave.com/search/api/   (free tier)
#   tavily — https://tavily.com/
#   searxng — a self-hosted SearXNG instance with JSON output enabled
# SOURCED_ANSWER_WEB_SEARCH=brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080
#
# LLM that writes the prose. Without one, the deterministic weave is used.
# Anthropic (default model claude-opus-5 — this runs per query, so
# claude-haiku-4-5 or claude-sonnet-5 are cheaper choices):
ANTHROPIC_API_KEY=
# SOURCED_ANSWER_ANTHROPIC_MODEL=claude-opus-5
# …or any OpenAI-compatible chat-completions endpoint (OpenAI, Ollama, …):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SOURCED_ANSWER_OPENAI_MODEL=gpt-4o-mini
#
# Tuning:
SOURCED_ANSWER_MAX_SOURCES=8
SOURCED_ANSWER_FETCH_TIMEOUT_MS=8000
SOURCED_ANSWER_LLM_TIMEOUT_MS=30000
# Comma-separated extra domains to treat as the "official" trust tier.
# SOURCED_ANSWER_TRUSTED_DOMAINS=example.gov,docs.internal.example
# Allow fetching sources on loopback / private hosts (SSRF guard; off by default).
SOURCED_ANSWER_ALLOW_PRIVATE=false

# --- Passive recon -------------------------------------------------------
# Profile a domain / IP / URL from public data: DNS (+ SPF/DMARC), RDAP/whois,
# the served TLS certificate, HTTP security-header grade + tech fingerprint,
# robots.txt / sitemap.xml, crt.sh subdomains, and IP geolocation. Passive only.
# See docs/recon.md. Everything here is OPTIONAL — the defaults just work.
SOURCED_RECON_ENABLED=true
SOURCED_RECON_TIMEOUT_MS=8000
# Allow targets that resolve to private / loopback addresses (off by default;
# the `sourced recon` CLI always allows them since a local operator runs it):
SOURCED_RECON_ALLOW_PRIVATE=false
# Use the system `whois` binary as a fallback when RDAP returns nothing:
SOURCED_RECON_WHOIS=true
# How many resolved addresses to geolocate for a domain target:
SOURCED_RECON_MAX_GEO_IPS=3
# Index every completed recon report as a searchable document:
SOURCED_RECON_INDEX_RESULTS=false

# --- MCP server -----------------------------------------------------------
# URL the `sourced-mcp` server uses for its search/index tools.
# Defaults to http://127.0.0.1:<SOURCED_PORT>.
# SOURCED_API_URL=http://127.0.0.1:7700
