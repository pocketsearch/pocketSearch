# Beacon Search configuration — every value has a safe default, so this file is
# entirely optional. Copy to `.env` and adjust as needed.

# --- HTTP server ---
BEACON_HOST=0.0.0.0
BEACON_PORT=7700
# Comma-separated origins, or leave blank to allow all.
BEACON_CORS_ORIGIN=

# --- Storage ---
# Directory for the persisted index (created automatically).
BEACON_DATA_DIR=data
# Full path to the index file (defaults to <BEACON_DATA_DIR>/index.json).
# BEACON_INDEX_FILE=data/index.json
# Directory containing the built web UI.
BEACON_WEB_DIR=web/dist
# Delay before flushing index changes to disk (ms).
BEACON_PERSIST_DEBOUNCE_MS=750

# --- Logging ---
# trace | debug | info | warn | error | silent
BEACON_LOG_LEVEL=info
BEACON_LOG_PRETTY=false

# --- Crawler ---
BEACON_CRAWL_USER_AGENT=BeaconSearchBot/1.0
BEACON_CRAWL_MAX_PAGES=50
BEACON_CRAWL_CONCURRENCY=4
BEACON_CRAWL_TIMEOUT_MS=15000
BEACON_CRAWL_DELAY_MS=150
# Allow the HTTP /api/crawl endpoint to reach loopback / private / link-local
# hosts. Off by default as an SSRF guard. The `beacon crawl` CLI always allows it.
BEACON_CRAWL_ALLOW_PRIVATE=false

# --- Limits ---
BEACON_MAX_BODY_BYTES=8388608
