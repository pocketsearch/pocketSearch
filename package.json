{
  "name": "abeaconsearch",
  "version": "1.0.0",
  "description": "Beacon Search — a self-hostable, fully open-source full-text search engine with a web UI. No external services required.",
  "type": "module",
  "license": "MIT",
  "author": "abeaconsearch contributors",
  "homepage": "https://github.com/abbieymatthews030-star/abeaconsearch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/abbieymatthews030-star/abeaconsearch.git"
  },
  "bugs": {
    "url": "https://github.com/abbieymatthews030-star/abeaconsearch/issues"
  },
  "keywords": [
    "search",
    "full-text-search",
    "search-engine",
    "self-hosted",
    "fastify",
    "typescript",
    "open-source"
  ],
  "bin": {
    "beacon": "dist/cli/index.js"
  },
  "main": "dist/server/index.js",
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.3",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "fastify": "^5.6.1",
    "minisearch": "^7.1.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.5"
  }
}
